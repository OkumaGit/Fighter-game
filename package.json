{
  "name": "fighter-game",
  "version": "1.0.0",
  "description": "Arena Clash 2D Fighter Game with 1v1 Online Multiplayer",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm run build --prefix client",
    "start": "node server.js",
    "dev": "concurrently \"node server.js\" \"npm run dev --prefix client\"",
    "install:all": "npm install && npm install --prefix client --include=dev",
    "start:server": "npm run start --prefix server",
    "start:client": "npm run dev --prefix client",
    "git:fix": "node scripts/fix-git.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OkumaGit/Fighter-game.git"
  },
  "keywords": [
    "fighting-game",
    "socket-io",
    "multiplayer"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
